{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build_cpp",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17",
        "-g",
        "${workspaceFolder}/main.cpp",
        "-lws2_32",
        "-o",
        "${workspaceFolder}/airwise_server.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "windows": {
        "args": [
          "-std=c++17",
          "-g",
          "${workspaceFolder}/main.cpp",
          "-lws2_32",
          "-o",
          "${workspaceFolder}/airwise_server.exe"
        ]
      },
      "linux": {
        "args": [
          "-std=c++17",
          "-g",
          "${workspaceFolder}/main.cpp",
          "-lpthread",
          "-o",
          "${workspaceFolder}/airwise_server"
        ]
      }
    }
  ]
}
